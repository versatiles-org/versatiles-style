{
	"name": "@versatiles/style",
	"version": "6.0.0",
	"description": "Generate StyleJSON for MapLibre",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">= 20.0.0"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"check": "npm run format && npm run lint && npm run build && npm run typecheck && npm run check-exports && npm run test:all",
		"check-exports": "tsx scripts/check-exports.ts",
		"compare": "tsx scripts/compare/compare.ts",
		"build": "rm -rf release; npm run build-browser && npm run build-node && npm run build-styles && npm run build-sprites && npm run icons-report && npm run doc",
		"build-browser": "rollup -c --environment BUILD:browser && $(cd release/versatiles-style; tar -cf - versatiles-style.* | gzip -9 > ../versatiles-style.tar.gz)",
		"build-node": "rm -rf dist && rollup -c --environment BUILD:node && chmod +x dist/index.js && rm -r dist/declaration",
		"build-styles": "tsx scripts/build-styles.ts",
		"build-sprites": "tsx scripts/build-sprites.ts",
		"dev": "vite",
		"doc": "npm run doc-graph",
		"doc-graph": "vrt deps-graph --collapse-dir \"src/shortbread/layers/*\" | vrt doc-insert README.md '### Dependency Graph'",
		"doc-screenshots": "tsx scripts/screenshots.ts",
		"doc-sprites": "tsx scripts/icons-report.ts --public --out docs/sprites.html",
		"doc-typescript": "vrt doc-typescript -f html",
		"extract-palette": "tsx scripts/extract-palette.ts",
		"icons-provenance": "tsx scripts/icons-provenance.ts",
		"icons-report": "tsx scripts/icons-report.ts",
		"format": "prettier --write --log-level warn .",
		"format:check": "prettier --check .",
		"lint": "eslint --color .",
		"prepack": "npm run build",
		"release": "vrt release-npm",
		"test": "vitest run --project unit",
		"test:e2e": "vitest run --project e2e",
		"test:all": "vitest run",
		"test-coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"upgrade": "vrt deps-upgrade",
		"prepare": "husky"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/versatiles-org/versatiles-style.git"
	},
	"author": "yetzt <versatiles@yetzt.me>, Michael Kreil <versatiles@michael-kreil.de>",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist/*"
	],
	"dependencies": {
		"@maplibre/maplibre-gl-style-spec": "^26.4.2"
	},
	"peerDependencies": {
		"maplibre-gl": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"maplibre-gl": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@maplibre/maplibre-gl-native": "^6.4.1",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/bin-pack": "^1.0.3",
		"@types/node": "^26.2.0",
		"@types/tar-stream": "^3.1.4",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@versatiles/release-tool": "^2.10.0",
		"@vitest/coverage-v8": "^5.0.0",
		"bin-pack": "^1.0.2",
		"eslint": "^10.10.0",
		"husky": "^9.1.7",
		"maplibre-gl": "^6.9.0",
		"prettier": "^3.9.6",
		"rollup": "^4.63.1",
		"rollup-plugin-dts": "^6.5.1",
		"rollup-plugin-sourcemaps2": "^0.5.8",
		"sharp": "^0.35.4",
		"tar-stream": "^3.2.1",
		"tslib": "^2.8.1",
		"tsx": "^4.23.13",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"allowScripts": {
		"@maplibre/maplibre-gl-native": true,
		"esbuild": true,
		"fsevents": true
	}
}
